# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore
# Optimizado para: Ionic + Angular + Cordova/Capacitor

# ─── Dependencias Node ─────────────────────────────
node_modules/
.pnp
.pnp.js
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# NOTA: package-lock.json SÍ debe subirse normalmente.
# Si lo ignoras, cada install puede traer versiones distintas.
# Descomenta la siguiente línea solo si sabes lo que haces.
# package-lock.json

# ─── Build / salidas generadas (Ionic + Angular) ───
/www
/dist
/out-tsc
/coverage
/.angular
/.sourcemaps
/.sass-cache
/.versions
/.ionic
/.tmp
*.tmp
*.tmp.*
.tmp/

# ─── Cordova ───────────────────────────────────────
/platforms
/plugins
/plugins/android.json
/plugins/ios.json
/merges/

# ─── Capacitor (aunque ahora esté desactivado, listo para el futuro) ──
/android
/ios
capacitor.config.local.ts

# Android / iOS generados y secretos de firma — NUNCA subir claves
*.keystore
*.jks
*.key
*.mobileprovision
*.provisionprofile
local.properties
*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM/

# ─── Variables de entorno y secretos ───────────────
.env
.env.*
!.env.example
*.local

# ─── Logs ──────────────────────────────────────────
*.log
log.txt
logs/

# ─── Sistema operativo ─────────────────────────────
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
$RECYCLE.BIN/
*~

# ─── VS Code ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.default
# Si quieres ignorar TODO de VS Code sin excepciones, usa solo:
# .vscode/

# ─── JetBrains (IntelliJ, WebStorm, PhpStorm, etc.) ─
.idea/
*.iml
*.iws
*.ipr
out/

# ─── Visual Studio (no VS Code) ────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.filters

# ─── Sublime Text ──────────────────────────────────
*.sublime-project
*.sublime-workspace

# ─── Vim / Emacs ───────────────────────────────────
*.sw[mnpcod]
*.swp
*.swo
*~
\#*\#
.\#*
.nfs*

# ─── Otros editores ────────────────────────────────
.project
.classpath
.settings/
*.code-workspace
.fleet/
.cursor/
.windsurf/

# ─── Tests ─────────────────────────────────────────
/coverage
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ─── Miscelánea ────────────────────────────────────
*.orig
*.rej
.cache/
.parcel-cache/
